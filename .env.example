# Шаблон переменных окружения для базы знаний ТГК.
# Скопируйте в .env и отредактируйте под свои данные.
# ВАЖНО: не коммитьте .env и его копии/бэкапы (.env.save и т.п.) — там реальные ключи.

# Путь к Obsidian vault
KB_VAULT_PATH=/home/user/Documents/KB

# Путь к лог-файлу (по умолчанию — data/kb_agent.log в каталоге проекта)
KB_LOG_PATH=./data/kb_agent.log

# Каналы Telegram через запятую (только имена, без https://t.me/).
# Используются при первом запуске для создания data/sources.yaml.
KB_TELEGRAM_CHANNELS=ragnarokzone,paragonzone,rubiconzone

# Каналы YouTube через запятую (полные URL).
# Используются при первом запуске для создания data/sources.yaml.
KB_YOUTUBE_CHANNELS=https://www.youtube.com/@example_channel

# Глубина бэклога YouTube в месяцах
KB_YT_MONTHS=16

# Языки субтитров через запятую
KB_YT_SUB_LANGS=ru,en

# Постов/видео с каждого источника за запуск
KB_LIMIT=10

# ----- LLM-провайдер -----
# Доступные провайдеры: openai, kimi, anthropic, ollama, openrouter, custom
# Любой провайдер должен предоставлять OpenAI-совместимый endpoint /chat/completions
KB_LLM_PROVIDER=openai

# API-ключ LLM-провайдера
KB_OPENAI_API_KEY=sk-ваш_ключ_здесь

# Базовый URL API провайдера (OpenAI-совместимый endpoint /chat/completions)
# OpenAI:           https://api.openai.com/v1
# Kimi (Moonshot):  https://api.moonshot.cn/v1
# OpenRouter:       https://openrouter.ai/api/v1
# Ollama:           http://localhost:11434/v1
KB_OPENAI_BASE_URL=https://api.openai.com/v1

# Модель LLM
# OpenAI:   gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Kimi:     moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k
# Ollama:   llama3, mistral, codellama
KB_OPENAI_MODEL=gpt-4o-mini

# Температура модели (0.0 - 1.0, меньше = более детерминированно)
KB_OPENAI_TEMPERATURE=0.3

# Максимум токенов в ответе
KB_OPENAI_MAX_TOKENS=2000

# Таймаут запроса к LLM (секунды) и число повторов при 429/5xx и сетевых ошибках
KB_LLM_TIMEOUT=60
KB_LLM_MAX_RETRIES=2

# ----- Необязательные переопределения путей -----
# KB_DATA_DIR=./data
# KB_DB_PATH=./data/state.db
# KB_SOURCES_PATH=./data/sources.yaml
# KB_PROFILE_PATH=./data/user_profile.yaml
# KB_PROMPTS_DIR=./config/prompts

# ----- MCP-сервер (Этап 4) -----
# Запуск: kb-agent mcp-serve
# Read-only инструменты: kb_search, kb_get_note, kb_get_insights,
#   kb_sources_status, kb_list_proposals, kb_get_proposal
# Write-инструменты (только через pending → kb-agent confirm <change_id>):
#   kb_add_source, kb_remove_source, kb_enable_source,
#   kb_update_profile, kb_revert_prompt, kb_reject_proposal

# ----- Локальная обработка и редактирование (6.2) -----
# Режим локальной обработки: данные не уходят к внешнему LLM
# KB_LOCAL_PROCESSING_MODE=false
# Поля для редакции при отправке внешнему LLM (через запятую)
# KB_REDACT_FIELDS=email,phone,canonical_url
# Источники, исключаемые из отправки внешнему LLM (через запятую)
# KB_REDACT_SOURCES=tg_private_chan,yt_internal_channel
